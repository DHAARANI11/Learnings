package BankingSystem;

import java.util.ArrayList;

public class Bank {
	    	private static Bank bank;
	        private Customer customer;
	        public ArrayList<Customer> customerList=new ArrayList<Customer>();
	        
	        private Bank() {}

	        public static Bank getInstance() {
	            if (bank == null)
	                bank = new Bank();
	            return bank;
	        }

	        public void createCustomer(String name, int type) {
	            Account account;
	            if (type == 1)
	                account = new Savings();
	            else
	                account = new Current();
	            customer = new Customer(name, account);
	            customerList.add(customer);
	            System.out.println("Customer created successfully!");
	        }
	        
	        public void deposit(int id,double amount) {
	            customerList.get(id-1).getAccount().deposit(amount);
	            System.out.println("Deposit successful");
	        }

	        public void withdraw(int id,double amount){
	            customerList.get(id-1).getAccount().withdraw(amount);
	            System.out.println("Withdrawal successful");
	        }

	        public void checkBalance(int id) {
	            System.out.println("Balance: " +customerList.get(id-1).getAccount().getBalance());
	        }

	        public void calculateInterest(int id) {
	            customerList.get(id-1).getAccount().calculateInterest();
	        }

			public void viewCustomer() {
				if(customerList.size()==0){
					System.out.println("Null");
					return;
				}
				for(int i=0;i<customerList.size();i++) {
					System.out.println(customerList.get(i));
				}
				
			}
	        
	}

